<!-- Typography and iconography for 1080p/4K televisions. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="ConsoleFontFamily">Segoe UI</FontFamily>
  <FontFamily x:Key="ConsoleIconFontFamily">Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="ConsoleModernIconFontFamily">Segoe Fluent Icons</FontFamily>
  <x:Double x:Key="IconSizeSmall">16</x:Double>
  <x:Double x:Key="IconSizeMedium">20</x:Double>
  <x:Double x:Key="IconSizeLarge">28</x:Double>
  <x:Double x:Key="IconSizeHero">36</x:Double>

  <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
    <Setter Property="FontSize" Value="36" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="46" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SectionHeadingTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="30" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="FileRowTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="MetadataTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="ControllerHintTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="120" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
  </Style>
</ResourceDictionary>
