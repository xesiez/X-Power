<!-- X-Power semantic design tokens. Values are tuned for 10-foot Xbox viewing. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Semantic colors -->
  <Color x:Key="ColorBackground">#121212</Color>
  <Color x:Key="ColorSurface">#1E1E1E</Color>
  <Color x:Key="ColorSurfaceElevated">#282828</Color>
  <Color x:Key="ColorSurfaceSecondary">#242A33</Color>
  <Color x:Key="ColorBorder">#3A414B</Color>
  <Color x:Key="ColorAccent">#168BFF</Color>
  <Color x:Key="ColorAccentBright">#45A7FF</Color>
  <Color x:Key="ColorSuccess">#39E879</Color>
  <Color x:Key="ColorWarning">#FFB547</Color>
  <Color x:Key="ColorDanger">#F05B66</Color>
  <Color x:Key="ColorInfo">#58B8F5</Color>
  <Color x:Key="ColorTextPrimary">#F5F7FA</Color>
  <Color x:Key="ColorTextSecondary">#B5BDC8</Color>
  <Color x:Key="ColorTextMuted">#858F9D</Color>

  <!-- Opaque brushes are the compatibility baseline for all surfaces. -->
  <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
  <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
  <SolidColorBrush x:Key="BrushSurfaceElevated" Color="{StaticResource ColorSurfaceElevated}" />
  <SolidColorBrush x:Key="BrushSurfaceSecondary" Color="{StaticResource ColorSurfaceSecondary}" />
  <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
  <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="BrushAccentBright" Color="{StaticResource ColorAccentBright}" />
  <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
  <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
  <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
  <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />
  <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
  <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
  <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

  <!-- Alpha overlays are optional enhancements; use the opaque fallback where transparency is unsuitable. -->
  <Color x:Key="ColorOverlayWhite08">#14FFFFFF</Color>
  <Color x:Key="ColorOverlayWhite12">#1FFFFFFF</Color>
  <Color x:Key="ColorOverlayAccent16">#29168BFF</Color>
  <SolidColorBrush x:Key="BrushOverlayWhite08" Color="{StaticResource ColorOverlayWhite08}" />
  <SolidColorBrush x:Key="BrushOverlayWhite12" Color="{StaticResource ColorOverlayWhite12}" />
  <SolidColorBrush x:Key="BrushOverlayAccent16" Color="{StaticResource ColorOverlayAccent16}" />
  <SolidColorBrush x:Key="BrushOverlayWhite08Fallback" Color="#282828" />
  <SolidColorBrush x:Key="BrushOverlayWhite12Fallback" Color="#303030" />
  <SolidColorBrush x:Key="BrushOverlayAccent16Fallback" Color="#202D3B" />

  <!-- Strict 4px spacing scale. Values are doubles for use in XAML layout properties. -->
  <x:Double x:Key="SpaceXS">4</x:Double>
  <x:Double x:Key="SpaceS">8</x:Double>
  <x:Double x:Key="SpaceM">16</x:Double>
  <x:Double x:Key="SpaceL">24</x:Double>
  <x:Double x:Key="SpaceXL">32</x:Double>
  <x:Double x:Key="SpaceXXL">48</x:Double>
  <x:Double x:Key="SpaceSection">60</x:Double>

  <!-- Corner radii -->
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <CornerRadius x:Key="RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="RadiusDialog">16</CornerRadius>

  <!-- Shared measurements -->
  <x:Double x:Key="FocusBorderThickness">2</x:Double>
  <x:Double x:Key="ConsoleFocusScale">1.025</x:Double>
  <x:Double x:Key="ConsoleFocusDurationMs">120</x:Double>
  <x:Double x:Key="StorageRootCardMinHeight">140</x:Double>
  <x:Double x:Key="ExplorerRowHeight">68</x:Double>
</ResourceDictionary>
