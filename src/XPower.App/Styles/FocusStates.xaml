<!-- Shared Xbox focus palette and motion values. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource ColorAccentBright}" />
  <SolidColorBrush x:Key="FocusGlowBrush" Color="#3345A7FF" />
  <SolidColorBrush x:Key="FocusPressedBrush" Color="#FF0D68C7" />
  <SolidColorBrush x:Key="FocusDisabledBrush" Color="#FF4B515A" />
  <SolidColorBrush x:Key="SelectionPillBrush" Color="#33168BFF" />
  <SolidColorBrush x:Key="SelectionPillBorderBrush" Color="#99168BFF" />

  <x:Double x:Key="FocusScale">1.025</x:Double>
  <x:Double x:Key="FocusDuration">0.12</x:Double>
  <x:Double x:Key="FocusBorderWidth">2</x:Double>
  <x:Double x:Key="FocusUnfocusedOpacity">0.88</x:Double>
  <x:Double x:Key="DisabledOpacity">0.42</x:Double>
  <SolidColorBrush x:Key="BrushTransparent" Color="#00000000" />
</ResourceDictionary>
