<Page x:Class="XPower.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource AppBackgroundBrush}" XYFocusKeyboardNavigation="Enabled">
  <Grid x:Name="RootLayout" Padding="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.RowSpan="2" Background="#0E1627" BorderBrush="#253149" BorderThickness="0,0,1,0">
      <Grid Padding="22,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="X-POWER" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
          <TextBlock Text="CONSOLE WORKSPACE" FontSize="10" CharacterSpacing="150" Foreground="{StaticResource SecondaryTextBrush}" Margin="1,3,0,0"/>
        </StackPanel>
        <Button Grid.Row="2" Content="⌂   Home" Tag="Home" Click="Navigation_Click" HorizontalContentAlignment="Left" Background="#19364A" Foreground="{StaticResource AccentBrush}" FontSize="19" Padding="18,14" Margin="0,0,0,10"/>
        <Button Grid.Row="3" Content="▤   Files" Tag="Files" Click="Navigation_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{StaticResource PrimaryTextBrush}" FontSize="19" Padding="18,14" Margin="0,0,0,10"/>
        <Button Grid.Row="4" Content="▣   Phone Transfer" Tag="Phone Transfer" Click="Navigation_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" FontSize="19" Padding="18,14" Margin="0,0,0,10"/>
        <Button Grid.Row="5" Content="♫   Music" Tag="Music" Click="Navigation_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" FontSize="19" Padding="18,14" Margin="0,0,0,10"/>
        <Button Grid.Row="6" Content="⚙   Settings" Tag="Settings" Click="Navigation_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" FontSize="19" Padding="18,14"/>
        <StackPanel Grid.Row="8" Spacing="5">
          <TextBlock Text="XBOX SERIES" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="UNIVERSAL WINDOWS PLATFORM" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Grid.Row="0" Background="#0E1627" Padding="34,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="3">
        <TextBlock Text="X-POWER  /  HOME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" CharacterSpacing="130"/>
        <TextBlock x:Name="PageTitle" Text="Console workspace" Foreground="{StaticResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="9">
        <Ellipse Width="8" Height="8" Fill="#65D9B2"/>
        <TextBlock Text="App ready" Foreground="#65D9B2" FontSize="14"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="34,28">
      <StackPanel Spacing="24">
        <Border Background="{StaticResource PanelBrush}" BorderBrush="#26364F" BorderThickness="1" CornerRadius="18" Padding="30">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="9">
              <TextBlock Text="WELCOME TO X-POWER" Foreground="{StaticResource AccentBrush}" FontSize="12" CharacterSpacing="170" FontWeight="SemiBold"/>
              <TextBlock Text="Your Xbox. Your workspace." FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="A clean place to manage your console files and everyday tools." FontSize="17" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="FOUNDATION BUILD  •  READY FOR THE NEXT STEP" Foreground="#65D9B2" FontSize="11" CharacterSpacing="80" Margin="0,8,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#19364A" CornerRadius="16" Padding="22" VerticalAlignment="Center" Margin="24,0,0,0">
              <StackPanel HorizontalAlignment="Center" Spacing="7">
                <TextBlock Text="XP" FontSize="42" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="X-POWER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" CharacterSpacing="100"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <StackPanel Spacing="5">
          <TextBlock Text="QUICK ACCESS" Foreground="{StaticResource AccentBrush}" FontSize="12" CharacterSpacing="150" FontWeight="SemiBold"/>
          <TextBlock Text="Pick up where you want to go" Foreground="{StaticResource PrimaryTextBrush}" FontSize="24" FontWeight="SemiBold"/>
        </StackPanel>

        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Grid.Column="0" Tag="Files" Click="Navigation_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#26364F" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="▤" FontSize="28" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="File Explorer" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Browse accessible folders and files" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="OPEN SECTION  →" FontSize="11" Foreground="{StaticResource AccentBrush}" CharacterSpacing="70" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </Button>
          <Button Grid.Column="1" Tag="Phone Transfer" Click="Navigation_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#26364F" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="▣" FontSize="28" Foreground="#A78BFA"/>
                <TextBlock Text="Phone Transfer" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Connect your phone and move files" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="OPEN SECTION  →" FontSize="11" Foreground="#A78BFA" CharacterSpacing="70" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </Button>
          <Button Grid.Column="2" Tag="Music" Click="Navigation_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#26364F" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="♫" FontSize="28" Foreground="#65D9B2"/>
                <TextBlock Text="Music" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Your audio space and playback tools" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="OPEN SECTION  →" FontSize="11" Foreground="#65D9B2" CharacterSpacing="70" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </Button>
        </Grid>

        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#26364F" BorderThickness="1" CornerRadius="14" Padding="22">
            <StackPanel Spacing="10">
              <TextBlock Text="NEXT MILESTONE" Foreground="{StaticResource AccentBrush}" FontSize="11" CharacterSpacing="130" FontWeight="SemiBold"/>
              <TextBlock Text="Real file browsing" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="The next update will introduce access to supported storage locations, with safe navigation and file selection." Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#102B2B" BorderBrush="#24504A" BorderThickness="1" CornerRadius="14" Padding="22">
            <StackPanel Spacing="8">
              <TextBlock Text="SYSTEM STATUS" Foreground="#65D9B2" FontSize="11" CharacterSpacing="130" FontWeight="SemiBold"/>
              <TextBlock Text="Foundation online" Foreground="{StaticResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="The app launched successfully. More tools will be added in small, tested updates." Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock Text="A  Select     B  Back     LB / RB  Switch sections     Y  Quick actions" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,12"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>