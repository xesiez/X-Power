<Page x:Class="XPower.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource AppBackgroundBrush}"
      KeyDown="MainPage_KeyDown"
      XYFocusKeyboardNavigation="Enabled">
  <Grid x:Name="RootLayout" Background="{StaticResource AppBackgroundBrush}" XYFocusKeyboardNavigation="Enabled">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="238"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Padding="20,26">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="26"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource ThemeColor01Brush}" BorderBrush="{StaticResource ThemeColor02Brush}" BorderThickness="1">
              <TextBlock Text="X" FontSize="27" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="X-POWER" FontSize="21" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
              <TextBlock Text="CONSOLE COMMAND" FontSize="9" CharacterSpacing="150" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="150" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,12"/>
        <Button x:Name="HomeNavButton" Grid.Row="3" Tag="Home" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="14,13" Background="{StaticResource ThemeColor03Brush}" Foreground="{StaticResource AccentBrush}" FontSize="16" BorderThickness="0" Margin="0,0,0,7">
          <StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock Text="Overview"/></StackPanel>
        </Button>
        <Button x:Name="FilesNavButton" Grid.Row="4" Tag="Files" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="14,13" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" FontSize="16" BorderThickness="0" Margin="0,0,0,7">
          <StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock Text="File Explorer"/></StackPanel>
        </Button>
        <Button x:Name="PhoneNavButton" Grid.Row="5" Tag="Phone Transfer" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="14,13" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" FontSize="16" BorderThickness="0" Margin="0,0,0,7">
          <StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock Text="Phone Link"/></StackPanel>
        </Button>
        <Button x:Name="MusicNavButton" Grid.Row="6" Tag="Music" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="14,13" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" FontSize="16" BorderThickness="0" Margin="0,0,0,7">
          <StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock Text="Media Player"/></StackPanel>
        </Button>
        <Button x:Name="SettingsNavButton" Grid.Row="7" Tag="Settings" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="14,13" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" FontSize="16" BorderThickness="0" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock Text="Preferences"/></StackPanel>
        </Button>

        <Border Grid.Row="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13">
          <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"/>
              <TextBlock Text="XBOX DEV MODE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
            </StackPanel>
            <TextBlock Text="Controller-first interface" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
            <TextBlock Text="X-POWER  /  2.2.1" FontSize="10" CharacterSpacing="90" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="72"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="42"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Padding="30,0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="3">
          <TextBlock x:Name="BreadcrumbText" Text="X-POWER   /   OVERVIEW" FontSize="10" CharacterSpacing="150" Foreground="{StaticResource SecondaryTextBrush}"/>
          <TextBlock x:Name="PageTitle" Text="Command center" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource ThemeColor04Brush}" BorderBrush="{StaticResource ThemeColor05Brush}" BorderThickness="1" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"/>
            <TextBlock x:Name="AppStatusText" Text="APP READY" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource SuccessBrush}"/>
          </StackPanel>
        </Border>
      </Grid>

      <ScrollViewer Grid.Row="1" Padding="28,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid x:Name="HomeView" Visibility="Visible">
            <StackPanel Spacing="20">
              <Border x:Name="HomeHeroPanel" Background="{StaticResource ThemeColor06Brush}" BorderBrush="{StaticResource ThemeColor07Brush}" BorderThickness="1" CornerRadius="18" Padding="26">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                  <StackPanel Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="YOUR CONSOLE. UNDER YOUR CONTROL." FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Welcome to your command center." FontSize="31" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="A focused workspace for files, phone connectivity and media on Xbox." FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="600"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                      <Button Tag="Files" Click="Navigation_Click" Background="{StaticResource AccentBrush}" Foreground="{StaticResource ThemeColor08Brush}" Padding="18,10" FontWeight="SemiBold" BorderThickness="0" Content="OPEN FILES"/>
                      <Button Tag="Phone Transfer" Click="Navigation_Click" Background="{StaticResource ThemeColor09Brush}" Foreground="{StaticResource PrimaryTextBrush}" Padding="18,10" BorderThickness="0" Content="PHONE LINK"/>
                    </StackPanel>
                  </StackPanel>
                  <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="170" Height="150">
                    <Ellipse Width="142" Height="142" Stroke="{StaticResource ThemeColor10Brush}" StrokeThickness="1" Opacity="0.8"/>
                    <Ellipse Width="108" Height="108" Stroke="{StaticResource ThemeColor11Brush}" StrokeThickness="2" Opacity="0.7"/>
                    <Ellipse Width="74" Height="74" Fill="{StaticResource ThemeColor12Brush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1"/>
                    <TextBlock Text="XP" FontSize="38" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Grid>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="SemiBold" CharacterSpacing="160" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Jump straight into a tool" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
              </StackPanel>

              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Tag="Files" Click="Navigation_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel Spacing="11">
                      <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource ThemeColor13Brush}" HorizontalAlignment="Left"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <TextBlock Text="File Explorer" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                      <TextBlock Text="Browse, search, inspect and copy files from app storage or USB." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                      <TextBlock Text="OPEN TOOL  &#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                  </Border>
                </Button>
                <Button Grid.Column="1" Tag="Phone Transfer" Click="Navigation_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel Spacing="11">
                      <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource ThemeColor14Brush}" HorizontalAlignment="Left"><TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{StaticResource ThemeColor15Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <TextBlock Text="Phone Link" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                      <TextBlock Text="View the console LAN health endpoint and connection status." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                      <TextBlock Text="OPEN TOOL  &#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource ThemeColor15Brush}"/>
                    </StackPanel>
                  </Border>
                </Button>
                <Button Grid.Column="2" Tag="Music" Click="Navigation_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel Spacing="11">
                      <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource ThemeColor16Brush}" HorizontalAlignment="Left"><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <TextBlock Text="Media Player" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                      <TextBlock Text="Choose a local audio file and play or pause it." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                      <TextBlock Text="OPEN TOOL  &#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                  </Border>
                </Button>
              </Grid>

              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                  <StackPanel Spacing="9">
                    <TextBlock Text="SYSTEM OVERVIEW" FontSize="10" FontWeight="SemiBold" CharacterSpacing="140" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="Built for the big screen" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="The interface is designed around directional navigation, clear focus states and large readable controls. Use the D-pad or left stick to move, A to select and B to return." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource ThemeColor17Brush}" BorderBrush="{StaticResource ThemeColor18Brush}" BorderThickness="1" CornerRadius="14" Padding="20">
                  <StackPanel Spacing="8">
                    <TextBlock Text="LOCAL SERVICE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="130" Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="LAN health probe" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="NetworkProbeStatus" Text="Starting local listener…" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Health endpoint only · no file upload enabled" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Grid>

          <Grid x:Name="FilesView" Visibility="Collapsed">
            <StackPanel Spacing="16">
              <StackPanel Spacing="5">
                <TextBlock Text="FILE EXPLORER" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Browse available storage" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Browse internal storage and connected USB devices. Xbox keeps system and other apps' private folders protected." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Button x:Name="AppStorageButton" Click="AppStorage_Click" Background="{StaticResource ThemeColor13Brush}" Foreground="{StaticResource AccentBrush}" Padding="15,10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Content="&#xE8B7;  INTERNAL STORAGE"/>
                <Button x:Name="UsbStorageButton" Click="UsbStorage_Click" Background="{StaticResource ThemeColor14Brush}" Foreground="{StaticResource ThemeColor15Brush}" Padding="15,10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Content="&#xE88E;  USB DEVICES"/>
                <Button x:Name="ExplorerUpButton" Click="ExplorerUp_Click" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource PrimaryTextBrush}" Padding="15,10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Content="&#xE74A;  UP" IsEnabled="False"/>
                <Button Click="ExplorerRefresh_Click" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource PrimaryTextBrush}" Padding="15,10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Content="&#xE72C;  REFRESH"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="ExplorerSearchBox" Width="280" PlaceholderText="Search this folder..." TextChanged="ExplorerSearchBox_TextChanged" />
                <Button x:Name="PreviewExplorerFileButton" Click="PreviewExplorerFile_Click" IsEnabled="False" Background="{StaticResource ThemeColor14Brush}" Foreground="{StaticResource ThemeColor15Brush}" Padding="15,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Content="&#xE8A5;  PREVIEW"/>
                <Button x:Name="CopyExplorerFileButton" Click="CopyExplorerFile_Click" IsEnabled="False" Background="{StaticResource ThemeColor13Brush}" Foreground="{StaticResource AccentBrush}" Padding="15,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Content="&#xE8C8;  COPY TO APP"/>
                <Button x:Name="PlayExplorerFileButton" Click="PlayExplorerFile_Click" IsEnabled="False" Background="{StaticResource ThemeColor16Brush}" Foreground="{StaticResource SuccessBrush}" Padding="15,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Content="&#xE768;  PLAY AUDIO"/>
              </StackPanel>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock x:Name="ExplorerPathText" Text="STORAGE LOCATIONS" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                  <TextBlock x:Name="ExplorerSummaryText" Text="Loading storage…" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                  <ListView x:Name="ExplorerListView" MinHeight="300" MaxHeight="500" Background="{StaticResource ThemeColor19Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ExplorerListView_ItemClick">
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Grid Padding="10,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource ThemeColor13Brush}"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Trailing}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                  <TextBlock Text="The full Xbox system drive and other apps' private folders are not accessible to UWP apps." FontSize="11" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Grid x:Name="PhoneView" Visibility="Collapsed">
            <StackPanel Spacing="18">
              <StackPanel Spacing="5">
                <TextBlock Text="PHONE LINK" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" Foreground="{StaticResource ThemeColor15Brush}"/>
                <TextBlock Text="Local network connection" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Enter the Xbox IPv4 address shown in Network Settings, then test the local health endpoint from a phone on the same LAN." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                <StackPanel Spacing="14">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse x:Name="PhoneServiceDot" Width="9" Height="9" Fill="{StaticResource WarningBrush}"/>
                    <TextBlock x:Name="PhoneServiceLabel" Text="STARTING HEALTH SERVICE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{StaticResource SuccessBrush}"/>
                  </StackPanel>
                  <TextBlock Text="XBOX IPv4 ADDRESS" FontSize="10" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{StaticResource SecondaryTextBrush}"/>
                  <TextBox x:Name="XboxIpTextBox" PlaceholderText="Enter Xbox IP from Settings > Network > Advanced settings" FontSize="16" TextChanged="XboxIpTextBox_TextChanged" XYFocusKeyboardNavigation="Enabled"/>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="RefreshNetworkButton" Click="RefreshNetwork_Click" Background="{StaticResource ThemeColor20Brush}" Foreground="White" Padding="18,11" BorderThickness="0" Content="BUILD HEALTH URL"/>
                    <Button x:Name="CopyAddressButton" Click="CopyAddress_Click" IsEnabled="False" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource PrimaryTextBrush}" Padding="18,11" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Content="COPY HEALTH URL"/>
                  </StackPanel>
                  <TextBlock x:Name="PhoneAddressText" Text="Enter the Xbox IPv4 address, then build the health URL." FontSize="18" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="PhoneStatusText" Text="HTTP health check only. This does not pair devices or transfer files. Do not send passwords or private data to this endpoint." FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource ThemeColor21Brush}" BorderBrush="{StaticResource ThemeColor22Brush}" BorderThickness="1" CornerRadius="14" Padding="20">
                <StackPanel Spacing="7">
                  <TextBlock Text="SECURITY NOTE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="130" Foreground="{StaticResource ThemeColor23Brush}"/>
                  <TextBlock Text="This endpoint returns non-sensitive status only. Secure HTTPS pairing, authenticated commands and file transfer are separate features and are not enabled in this build." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Grid x:Name="MusicView" Visibility="Collapsed">
            <StackPanel Spacing="18">
              <StackPanel Spacing="5">
                <TextBlock Text="MEDIA PLAYER" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" Foreground="{StaticResource SuccessBrush}"/>
                <TextBlock Text="Your local audio space" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Select a supported audio file from storage and control playback with the Xbox controller." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Background="{StaticResource ThemeColor24Brush}" BorderBrush="{StaticResource ThemeColor25Brush}" BorderThickness="1" CornerRadius="18" Padding="26">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                  <Border Width="112" Height="112" CornerRadius="56" Background="{StaticResource ThemeColor26Brush}" BorderBrush="{StaticResource ThemeColor27Brush}" BorderThickness="2">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock x:Name="TrackTitleText" Text="Nothing playing" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Center"/>
                  <TextBlock x:Name="TrackStatusText" Text="Choose an audio file to begin." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button x:Name="SelectTrackButton" Click="SelectTrack_Click" Background="{StaticResource AccentBrush}" Foreground="{StaticResource ThemeColor08Brush}" Padding="18,11" BorderThickness="0" Content="CHOOSE TRACK"/>
                    <Button Click="PlayTrack_Click" Background="{StaticResource ThemeColor28Brush}" Foreground="White" Padding="18,11" BorderThickness="0" Content="PLAY"/>
                    <Button Click="PauseTrack_Click" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource PrimaryTextBrush}" Padding="18,11" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Content="PAUSE"/>
                    <Button Click="StopTrack_Click" Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource PrimaryTextBrush}" Padding="18,11" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Content="STOP"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <MediaElement x:Name="AudioPlayer" Width="1" Height="1" Opacity="0" AreTransportControlsEnabled="False" AutoPlay="False" />
            </StackPanel>
          </Grid>

          <Grid x:Name="SettingsView" Visibility="Collapsed">
            <StackPanel Spacing="18">
              <StackPanel Spacing="5">
                <TextBlock Text="PREFERENCES" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Make X-Power yours" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Your preferences are saved locally on this console." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
              </StackPanel>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
                <StackPanel Spacing="16">
                  <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="140" Foreground="{StaticResource AccentBrush}"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="Light theme" FontSize="15" Foreground="{StaticResource PrimaryTextBrush}"/><TextBlock Text="Switch between dark and light palettes." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><ToggleSwitch x:Name="ThemeToggle" Grid.Column="1" Toggled="ThemeToggle_Toggled"/></Grid>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="Accent color" FontSize="15" Foreground="{StaticResource PrimaryTextBrush}"/><TextBlock Text="Choose the interface highlight color." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><ComboBox x:Name="AccentComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="AccentComboBox_SelectionChanged"><ComboBoxItem Content="Xbox Green"/><ComboBoxItem Content="Cyan"/><ComboBoxItem Content="Purple"/><ComboBoxItem Content="Blue"/></ComboBox></Grid>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="4K dashboard backdrop" FontSize="15" Foreground="{StaticResource PrimaryTextBrush}"/><TextBlock Text="Choose one of the bundled high-resolution X-Power scenes." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><ComboBox x:Name="WallpaperComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="WallpaperComboBox_SelectionChanged"><ComboBoxItem Content="Aurora Core"/><ComboBoxItem Content="Deep Current"/><ComboBoxItem Content="Violet Pulse"/><ComboBoxItem Content="Solar Ember"/><ComboBoxItem Content="Arctic Grid"/><ComboBoxItem Content="Emerald Drift"/><ComboBoxItem Content="Crimson Orbit"/><ComboBoxItem Content="Midnight Circuit"/></ComboBox></Grid>
                  <Border Height="1" Background="{StaticResource BorderBrush}"/>
                  <TextBlock Text="FILE EXPLORER" FontSize="10" FontWeight="SemiBold" CharacterSpacing="140" Foreground="{StaticResource AccentBrush}"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="Sort items by" FontSize="15" Foreground="{StaticResource PrimaryTextBrush}"/><TextBlock Text="Choose the order for files and folders." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><ComboBox x:Name="SortComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="SortComboBox_SelectionChanged"><ComboBoxItem Content="Name (A to Z)"/><ComboBoxItem Content="Name (Z to A)"/><ComboBoxItem Content="Folders first"/></ComboBox></Grid>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="Show file extensions" FontSize="15" Foreground="{StaticResource PrimaryTextBrush}"/><TextBlock Text="Display extensions in file names." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><ToggleSwitch x:Name="ShowExtensionsToggle" Grid.Column="1" IsOn="True" Toggled="ShowExtensionsToggle_Toggled"/></Grid>
                  <Border Height="1" Background="{StaticResource BorderBrush}"/>
                  <TextBlock Text="CONTROLLER &amp; SYSTEM" FontSize="10" FontWeight="SemiBold" CharacterSpacing="140" Foreground="{StaticResource AccentBrush}"/>
                  <TextBlock Text="D-pad / Left Stick · Navigate    A · Select    B · Back" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="X-Power 2.2.1 · Xbox Series · UWP" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                  <Button Click="ResetSettings_Click" HorizontalAlignment="Left" Background="{StaticResource DangerBrush}" Foreground="{StaticResource ThemeColor08Brush}" Padding="16,9" BorderThickness="0" Content="RESET PREFERENCES"/>
                  <TextBlock x:Name="SettingsStatusText" Text="Preferences are saved on this console." FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="X-POWER  •  XBOX SERIES X DEVELOPER MODE" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="A  SELECT     B  BACK" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>