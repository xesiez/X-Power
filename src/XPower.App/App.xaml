<Application x:Class="XPower.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:XPower">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#080D18" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#0D1524" />
      <SolidColorBrush x:Key="PanelBrush" Color="#111D2E" />
      <SolidColorBrush x:Key="PanelAltBrush" Color="#17263A" />
      <SolidColorBrush x:Key="BorderBrush" Color="#263A52" />
      <SolidColorBrush x:Key="AccentBrush" Color="#52E0D0" />
      <SolidColorBrush x:Key="AccentAltBrush" Color="#65A8FF" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F6FF" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#93A6BF" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#70E0A5" />
      <SolidColorBrush x:Key="WarningBrush" Color="#F2C879" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FF7E8A" />
    </ResourceDictionary>
  </Application.Resources>
</Application>